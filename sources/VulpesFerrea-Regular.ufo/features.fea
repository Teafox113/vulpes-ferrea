languagesystem DFLT dflt;
languagesystem latn dflt;

@L_T = [T];
@L_V = [V W];
@L_Y = [Y Yacute Ydieresis];
@L_L = [L];
@L_FP = [F P];
@L_KX = [K];
@L_A = [A Agrave Aacute Acircumflex Atilde Adieresis Aring];
@L_r = [r];
@L_vwy = [v w y yacute ydieresis];
@L_kx = [k];
@L_f = [f];
@L_quote = [quotesingle quotedbl quoteright quotedblright quoteleft quotedblleft];
@L_comma = [period comma ellipsis quotesinglbase quotedblbase];
@L_hyph = [hyphen endash emdash];
@R_O = [C G O Q Oslash OE Ccedilla Ograve Oacute Ocircumflex Otilde Odieresis];
@R_A = [A AE Agrave Aacute Acircumflex Atilde Adieresis Aring];
@R_J = [J];
@R_T = [T];
@R_Y = [Y Yacute Ydieresis];
@R_lr = [a c d e g o q s ae oe oslash eth agrave aacute acircumflex atilde adieresis aring ccedilla egrave eacute ecircumflex edieresis ograve oacute ocircumflex otilde odieresis scaron];
@R_lx = [m n p r u x dotlessi mu igrave iacute icircumflex idieresis ntilde ugrave uacute ucircumflex udieresis];
@R_lv = [v w y yacute ydieresis];
@R_lz = [z zcaron];
@R_quote = [quotesingle quotedbl quoteright quotedblright quoteleft quotedblleft];
@R_comma = [period comma ellipsis quotesinglbase quotedblbase];
@R_hyph = [hyphen endash emdash];
@figs = [zero one two three four five six seven eight nine];
@pnum = [zero.pnum one.pnum two.pnum three.pnum four.pnum five.pnum six.pnum seven.pnum eight.pnum nine.pnum];
@numr = [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];
@dnom = [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];
@case_in = [hyphen endash emdash guilsinglleft guilsinglright guillemotleft guillemotright parenleft parenright bracketleft bracketright braceleft braceright exclamdown questiondown periodcentered bullet];
@case_out = [hyphen.case endash.case emdash.case guilsinglleft.case guilsinglright.case guillemotleft.case guillemotright.case parenleft.case parenright.case bracketleft.case bracketright.case braceleft.case braceright.case exclamdown.case questiondown.case periodcentered.case bullet.case];

feature kern {
  pos @L_T @R_lr -75;
  pos @L_T @R_lx -60;
  pos @L_T @R_lv -45;
  pos @L_T @R_lz -45;
  pos @L_T @R_comma -75;
  pos @L_T @R_hyph -60;
  pos @L_T @R_A -30;
  pos @L_T @R_O -15;
  pos @L_T @R_J -60;
  pos @L_V @R_lr -30;
  pos @L_V @R_lx -15;
  pos @L_V @R_comma -45;
  pos @L_V @R_A -15;
  pos @L_V @R_O -15;
  pos @L_V @R_J -15;
  pos @L_Y @R_lr -60;
  pos @L_Y @R_lx -45;
  pos @L_Y @R_comma -75;
  pos @L_Y @R_hyph -45;
  pos @L_Y @R_A -30;
  pos @L_Y @R_O -15;
  pos @L_Y @R_J -60;
  pos @L_L @R_T -75;
  pos @L_L @R_Y -75;
  pos @L_L @R_quote -90;
  pos @L_L @R_hyph -45;
  pos @L_L @R_O -15;
  pos @L_FP @R_comma -75;
  pos @L_FP @R_A -30;
  pos @L_FP @R_lr -30;
  pos @L_FP @R_J -45;
  pos @L_KX @R_O -30;
  pos @L_KX @R_lr -30;
  pos @L_KX @R_hyph -45;
  pos @L_A @R_T -30;
  pos @L_A @R_Y -30;
  pos @L_A @R_quote -45;
  pos @L_r @R_comma -60;
  pos @L_r @R_hyph -30;
  pos @L_vwy @R_comma -45;
  pos @L_vwy @R_lr -15;
  pos @L_kx @R_lr -30;
  pos @L_kx @R_hyph -30;
  pos @L_f @R_quote 30;
  pos @L_f @R_comma -30;
  pos @L_quote @R_A -45;
  pos @L_quote @R_J -60;
  pos @L_quote @R_lr -30;
  pos @L_comma @R_T -75;
  pos @L_comma @R_Y -75;
  pos @L_comma @R_quote -90;
  pos @L_hyph @R_T -60;
  pos @L_hyph @R_Y -45;
} kern;

feature pnum { sub @figs by @pnum; } pnum;
feature tnum { sub @pnum by @figs; } tnum;
feature zero { sub zero by zero.slash; } zero;
feature case { sub @case_in by @case_out; } case;
feature frac {
  lookup FRAC_N { sub @figs by @numr; } FRAC_N;
  lookup FRAC_S { sub slash by fraction; } FRAC_S;
  lookup FRAC_D { sub [fraction @dnom] @numr' by @dnom; } FRAC_D;
} frac;
feature numr { sub @figs by @numr; } numr;
feature dnom { sub @figs by @dnom; } dnom;
